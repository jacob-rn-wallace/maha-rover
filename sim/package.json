{
  "name": "al-maha-sim",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "license": "Apache-2.0",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "check:load": "esbuild tests/load-time.ts --bundle --platform=node --format=esm --outfile=.check/load-time.mjs --log-level=warning && node .check/load-time.mjs",
    "check:soil": "esbuild tests/soil-check.ts --bundle --platform=node --format=esm --outfile=.check/soil-check.mjs --log-level=warning && node .check/soil-check.mjs",
    "check:rocks": "esbuild tests/rocks-check.ts --bundle --platform=node --format=esm --outfile=.check/rocks-check.mjs --log-level=warning && node .check/rocks-check.mjs",
    "check:limits": "esbuild tests/limits-check.ts --bundle --platform=node --format=esm --outfile=.check/limits-check.mjs --log-level=warning && node .check/limits-check.mjs",
    "bench:summary": "node tests/bench-summary.mjs"
  },
  "dependencies": {
    "@dimforge/rapier3d-compat": "^0.14.0",
    "fast-png": "^8.0.0",
    "three": "^0.170.0"
  },
  "devDependencies": {
    "@types/three": "^0.170.0",
    "typescript": "^5.7.2",
    "vite": "^6.0.7"
  }
}
