.DS_Store
__pycache__/
*.pyc
.venv/
venv/
# generated outputs from comparison scripts
graphic-design/scripts/mosaic/*.svg
graphic-design/scripts/mosaic/*.png

# any folder with "do-not-track" in its name stays local
*do-not-track*/

# generated CAD meshes (STEP is tracked)
hardware/**/out/*.stl

# generated full-assembly STEP (6 MB, regenerate with hardware/assembly/rover.py)
hardware/assembly/out/*.step
